    font-weight: 600;
    font-family: &quot;Consolas&quot;;
    padding-right: 4px;
}
QPushButton {
    background-color: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #E3E5E8;
    border-radius: 12px;
    font-size: 20px;
    font-family: &quot;Microsoft YaHei&quot;;
}
QPushButton:hover {
    background-color: #F7F8FA;
}
QPushButton:pressed, QPushButton[keyPressed=&quot;true&quot;] {
    background-color: #DCE3EC;
    border: 1px solid #B9C4D2;
}
QPushButton#btnClearAll, QPushButton#btnClearEntry, QPushButton#btnBackspace,
QPushButton#btnSign, QPushButton#btnPercent {
    background-color: #E8EAEE;
    color: #3C4149;
    font-size: 18px;
}
QPushButton#btnClearAll:hover, QPushButton#btnClearEntry:hover,
QPushButton#btnBackspace:hover, QPushButton#btnSign:hover,
QPushButton#btnPercent:hover {
    background-color: #DDE0E6;
}
QPushButton#btnEquals {
    background-color: #2F6FED;
    color: #FFFFFF;
    font-size: 24px;
    border: 1px solid #2F6FED;
}
QPushButton#btnEquals:hover {
    background-color: #4680F2;
}
QPushButton#btnEquals:pressed, QPushButton#btnEquals[keyPressed=&quot;true&quot;] {
    background-color: #2559C4;
}
QPushButton#opAdd, QPushButton#opSub, QPushButton#opMul, QPushButton#opDiv {
    background-color: #EDF3FF;
    color: #2F6FED;
    font-size: 22px;
    border: 1px solid #D7E3FB;
}
QPushButton#opAdd:hover, QPushButton#opSub:hover,
QPushButton#opMul:hover, QPushButton#opDiv:hover {
    background-color: #E2EBFF;
}
QPushButton#opAdd[active=&quot;true&quot;], QPushButton#opSub[active=&quot;true&quot;],
QPushButton#opMul[active=&quot;true&quot;], QPushButton#opDiv[active=&quot;true&quot;] {
    background-color: #2F6FED;
    color: #FFFFFF;
    border: 1px solid #2F6FED;
}
QStatusBar {
    color: #8A8F99;
    font-size: 11px;
}</string>
